<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/recordContainer"
    android:layout_width="match_parent"
    android:layout_height="match_parent">


    <View
        android:id="@+id/recordHalo"
        android:layout_width="104sp"
        android:layout_height="104sp"
        android:layout_gravity="center"
        android:alpha="0"
        android:background="@drawable/bg_record_halo"
        android:visibility="invisible" />


    <ImageButton
        android:id="@+id/recordButton"

        android:layout_width="84dp"
        android:layout_height="84dp"
        android:layout_gravity="center"
        android:background="#00FFFFFF"
        android:contentDescription="@string/record_button"
        android:scaleType="centerCrop"
        android:src="@drawable/microphone"
        android:stateListAnimator="@animator/button_press" />

</FrameLayout>